---
import ProgressMeter from '../components/ui/ProgressMeter.astro';
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/content/catalog';

const catalog = await getCatalog();
---

<Base title="Learn" description="The German course, level by level, from A1 to B1.">
  <header class="max-w-3xl">
    <p class="eyebrow" lang="de">Der Kurs</p>
    <h1 class="mt-1 text-4xl sm:text-5xl">Learn</h1>
    <p class="mt-3 text-lg text-muted">
      One course from the first word to the B1 exam. Each chapter explains a piece of grammar or a topic, gives you its
      words, and lets you practise until it holds.
    </p>
  </header>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      catalog.levels.map((level) => {
        const ids = level.lessons.flatMap((lesson) => lesson.exercises.map((exercise) => exercise.id));
        const planned = level.status === 'planned';
        return (
          <li>
            <a href={level.href} class:list={['card flex h-full flex-col gap-3 p-5 transition-colors hover:border-ink', planned && 'opacity-70']}>
              <span class="flex items-baseline justify-between gap-3">
                <span class="font-display text-4xl font-semibold">{level.title}</span>
                <span class="chip">{planned ? 'Planned' : `${level.lessons.length} chapters`}</span>
              </span>
              <span class="font-semibold">{level.name}</span>
              <span class="flex-1 text-muted">{level.description}</span>
              {!planned && ids.length > 0 && <ProgressMeter ids={ids} />}
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>
