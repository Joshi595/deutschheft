---
import PageHeader from '../components/ui/PageHeader.astro';
import ProgressMeter from '../components/ui/ProgressMeter.astro';
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/content/catalog';

const catalog = await getCatalog();
// Each level takes one of the article colours, written out so Tailwind finds them.
const band = ['bg-der', 'bg-die', 'bg-das'];
const ink = ['text-der', 'text-die', 'text-das'];
---

<Base title="Learn" description="The German course, level by level, from A1 to B1.">
  <PageHeader
    title="Learn"
    lead="One course from the first word to the B1 exam. Each chapter explains a piece of grammar or a topic, gives you its words, and lets you practise until it holds."
  />

  <ul class="mt-10 grid border-t border-l border-line sm:grid-cols-2">
    {
      catalog.levels.map((level, index) => {
        const ids = level.lessons.flatMap((lesson) => lesson.exercises.map((exercise) => exercise.id));
        const planned = level.status === 'planned';
        return (
          <li class="flex border-r border-b border-line">
            <a href={level.href} class="group flex w-full flex-col bg-bg transition-colors hover:bg-surface-2">
              <span class:list={['h-2', planned ? 'bg-line' : band[index % band.length]]} aria-hidden="true" />
              <span class="flex flex-1 flex-col gap-3 p-6">
                <span class="flex items-start justify-between gap-3">
                  <span class:list={['numeral text-8xl', planned ? 'text-muted' : ink[index % ink.length]]}>{level.title}</span>
                  <span class="chip">{planned ? 'Planned' : `${level.lessons.length} chapters`}</span>
                </span>
                <span class="font-display text-2xl">{level.name}</span>
                <span class:list={['flex-1', planned ? 'text-muted' : '']}>{level.description}</span>
                {!planned && ids.length > 0 && <ProgressMeter ids={ids} />}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>
