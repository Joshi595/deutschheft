---
import PageHeader from '../components/ui/PageHeader.astro';
import ProgressPage from '../components/progress/ProgressPage';
import CourseData from '../components/ui/CourseData.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Progress" description="Your week, your levels, your strong and weak topics, and the milestones you have reached.">
  <CourseData />

  <PageHeader title="Progress" lead="Counted in this browser from your own answers. Nothing here is estimated, and nothing is sent anywhere." />

  <div class="mt-8">
    <ProgressPage client:only="react">
      <div slot="fallback" class="skeleton min-h-48" role="status"><span class="sr-only">Adding it up …</span></div>
    </ProgressPage>
  </div>
</Base>
