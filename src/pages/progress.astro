---
import ProgressPage from '../components/progress/ProgressPage';
import CourseData from '../components/ui/CourseData.astro';
import Base from '../layouts/Base.astro';
---

<Base area="progress" localNav={[
  { id: 'week', label: 'This week' }, { id: 'totals', label: 'Totals' },
  { id: 'levels', label: 'Levels' }, { id: 'topics', label: 'Topics' }, { id: 'stamps', label: 'Milestones' },
]} title="Progress" description="Your week, your levels, your strong and weak topics, and the milestones you have reached.">
  <CourseData />

  <header>
    <p class="eyebrow" lang="de">Mein Fortschritt</p>
    <h1 class="mt-1 text-4xl sm:text-5xl">Progress</h1>
    <p class="mt-3 text-lg text-muted">
      Counted in this browser from your own answers. Nothing here is estimated, and nothing is sent anywhere.
    </p>
  </header>

  <div class="mt-8">
    <ProgressPage client:only="react">
      <div slot="fallback" class="card p-6 text-muted">Adding it up …</div>
    </ProgressPage>
  </div>
</Base>
