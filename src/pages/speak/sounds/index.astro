---
import VoiceNotice from '../../../components/ui/VoiceNotice.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Base from '../../../layouts/Base.astro';
import { getCatalog } from '../../../lib/content/catalog';
import { url } from '../../../lib/url';

const { sounds } = await getCatalog();
---

<Base title="Sounds" description="The German sounds English does not have: hear the difference, then say them.">
  <PageHeader
    title="Sounds"
    crumbs={[{ label: 'Speak', href: url('speak/') }, { label: 'Sounds' }]}
    lead="Twelve sounds carry most of a German accent. For each one you read how it is made, train your ear on pairs of similar words, and then say the words yourself. Take them in order, or start with the one you notice most."
  />
  <VoiceNotice />

  <ol class="mt-8 grid gap-3 sm:grid-cols-2">
    {
      sounds.map((sound) => (
        <li class="min-w-0">
          <a href={sound.href} class="card flex h-full items-center gap-4 p-5 transition-colors hover:border-ink">
            <span class="min-w-0 flex-1">
              <span class="font-display block text-2xl font-semibold" lang="de">{sound.title}</span>
              <span class="text-muted">{sound.name}</span>
            </span>
            <span class="chip" data-sound={sound.id}>New</span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<script>
  import { EAR_PASS, EAR_ROUND } from '../../../lib/speaking/logic';
  import { $speaking } from '../../../lib/stores';

  // Which sounds the learner has passed by ear, and their best score on the others.
  $speaking.subscribe((speaking) => {
    document.querySelectorAll<HTMLElement>('[data-sound]').forEach((chip) => {
      const best = speaking.ears[chip.dataset.sound ?? ''] ?? 0;
      chip.textContent = best >= EAR_PASS ? 'Passed' : best > 0 ? `${best} of ${EAR_ROUND}` : 'New';
      chip.classList.toggle('chip-good', best >= EAR_PASS);
    });
  });
</script>