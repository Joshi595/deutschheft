---
import VoiceNotice from '../../components/ui/VoiceNotice.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SentenceSession from '../../components/speak/SentenceSession';
import CourseData from '../../components/ui/CourseData.astro';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
---

<Base title="Sentences" description="Say German sentences aloud from a cue, and have them come back until they are automatic." width="narrow">
  <CourseData />

  <PageHeader
    title="Sentences"
    crumbs={[{ label: 'Speak', href: url('speak/') }, { label: 'Sentences' }]}
    lead="Knowing a sentence and being able to say it are different things. Here you say it, every time, before you see it."
  />
  <VoiceNotice />

  <div class="mt-8">
    <SentenceSession client:only="react" bankHref={url('speak/phrases.json')} speakHref={url('speak/')} conversationsHref={url('speak/conversations/')}>
      <div slot="fallback" class="skeleton min-h-48" role="status"><span class="sr-only">Loading your sentences …</span></div>
    </SentenceSession>
  </div>
</Base>