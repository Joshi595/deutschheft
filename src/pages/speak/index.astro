---
import SpeakHub from '../../components/speak/SpeakHub';
import CourseData from '../../components/ui/CourseData.astro';
import Base from '../../layouts/Base.astro';
import { getCatalog } from '../../lib/content/catalog';
import { url } from '../../lib/url';

const catalog = await getCatalog();
const talks = catalog.talks.map(({ id, level, titleDe, href }) => ({ id, level, titleDe, href }));
const sounds = catalog.sounds.map(({ id, title, href }) => ({ id, title, href }));
const exams = catalog.levels
  .filter((level) => level.status === 'active' && level.lessons.length > 0)
  .map((level) => ({ id: level.id, title: level.title, href: url(`speak/exam/${level.id}/`) }));
---

<Base title="Speak" description="Speaking practice: German sounds, sentences said aloud, conversations and exam speaking tasks.">
  <CourseData />

  <header>
    <p class="eyebrow" lang="de">Sprechen</p>
    <h1 class="mt-1 text-4xl sm:text-5xl">Speak</h1>
    <p class="mt-3 text-lg text-muted">
      Here everything is said aloud. You always hear a model, you can record yourself next to it, and what you
      practise comes back on later days.
    </p>
  </header>

  <div class="mt-8">
    <SpeakHub
      client:only="react"
      talks={talks}
      sounds={sounds}
      exams={exams}
      hrefs={{ sounds: url('speak/sounds/'), sentences: url('speak/sentences/'), conversations: url('speak/conversations/') }}
    >
      <div slot="fallback" class="card min-h-64 p-6 text-muted">Getting your speaking practice ready …</div>
    </SpeakHub>
  </div>
</Base>
