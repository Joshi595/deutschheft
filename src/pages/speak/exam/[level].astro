---
import ExamSpeaking, { type ExamGroup } from '../../../components/speak/ExamSpeaking';
import Base from '../../../layouts/Base.astro';
import { getCatalog } from '../../../lib/content/catalog';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.levels.filter((level) => level.lessons.length > 0).map((level) => ({ params: { level: level.id } }));
}

const catalog = await getCatalog();
const level = catalog.levels.find((candidate) => candidate.id === Astro.params.level)!;

// The same part of the exam from every mock exam goes into one group.
const parts = new Map<string, ExamGroup>();
for (const quiz of level.quizzes) {
  for (const section of quiz.sections.filter((candidate) => candidate.skill === 'speaking')) {
    for (const part of section.parts) {
      const group = parts.get(part.title) ?? { title: part.title, note: part.instructions, tasks: [] };
      group.tasks.push(...part.items.map((item) => ({ item, from: quiz.title })));
      parts.set(part.title, group);
    }
  }
}

const fromChapters: ExamGroup = {
  title: 'From the chapters',
  note: 'The speaking task that closes a chapter, on that chapter\'s topic.',
  tasks: level.lessons.flatMap((lesson) =>
    lesson.sets.flatMap((set) => set.items.filter((item) => item.type === 'speaking-task').map((item) => ({ item, from: lesson.title }))),
  ),
};
const groups = [...parts.values(), fromChapters].filter((group) => group.tasks.length > 0);
const count = groups.reduce((sum, group) => sum + group.tasks.length, 0);
// Roughly what one exam turn takes at each level.
const seconds = ({ a1: 60, a2: 90 } as Record<string, number>)[level.id] ?? 180;
---

<Base title={`Exam speaking ${level.title}`} description={`Every ${level.title} speaking task of the course, against the clock.`} width="narrow">

  <header class="mt-4">
    <p class="eyebrow" lang="de">Prüfung Sprechen</p>
    <h1 class="mt-1 text-4xl sm:text-5xl">Exam speaking {level.title}</h1>
    <p class="mt-3 text-muted">
      {count} speaking tasks, grouped by exam part. Start the clock, speak, then compare with the model answer and tick
      what your answer managed. {level.exam && `They follow the ${level.exam}.`}
    </p>
  </header>

  <div class="mt-8">
    <ExamSpeaking client:only="react" groups={groups} seconds={seconds}>
      <div slot="fallback" class="card p-6 text-muted">Loading the tasks …</div>
    </ExamSpeaking>
  </div>
</Base>
