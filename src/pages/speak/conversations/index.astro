---
import Base from '../../../layouts/Base.astro';
import { getCatalog } from '../../../lib/content/catalog';
import { MISSION_ICONS } from '../../../lib/content/icons';

const catalog = await getCatalog();
const groups = catalog.levels
  .map((level) => ({ level, talks: catalog.talks.filter((talk) => talk.level === level.id) }))
  .filter((group) => group.talks.length > 0);
---

<Base title="Conversations" description="Everyday situations to speak through: the app speaks the other person, you speak your part.">

  <header class="mt-4">
    <p class="eyebrow" lang="de">Gespräche</p>
    <h1 class="mt-1 text-4xl sm:text-5xl">Conversations</h1>
    <p class="mt-3 text-lg text-muted">
      The app speaks the other person and you speak your part: first reading your lines, then from a cue, then from
      memory. Some situations also have a guided mission, which teaches the lines step by step before you speak them.
    </p>
  </header>

  {
    groups.map(({ level, talks }) => (
      <section class="mt-10" aria-labelledby={`talks-${level.id}`}>
        <h2 id={`talks-${level.id}`} class="text-2xl">
          {level.title} <span class="text-muted">{level.name}</span>
        </h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {talks.map((talk) => (
            <li class="card flex min-w-0 gap-4 p-5">
              <span class="grid size-14 flex-none place-items-center rounded-2xl bg-accent-soft">
                <svg width="34" height="34" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={MISSION_ICONS[talk.icon]} />
                </svg>
              </span>
              <span class="flex min-w-0 flex-1 flex-col gap-2">
                <span>
                  <span class="font-display block text-2xl font-semibold break-words hyphens-auto" lang="de">{talk.titleDe}</span>
                  <span class="text-sm text-muted">{talk.title}</span>
                </span>
                <span class="flex-1">{talk.scene}</span>
                <span class="text-sm text-muted" data-talk={talk.id}>Not spoken yet</span>
                <span class="flex flex-wrap gap-2">
                  <a href={talk.href} class="btn btn-accent btn-small">Speak it</a>
                  {talk.missionHref && <a href={talk.missionHref} class="btn btn-small">Guided mission</a>}
                </span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<script>
  import { $speaking } from '../../../lib/stores';

  // How far each conversation has been taken, from the learner's own record.
  const REACHED = ['Not spoken yet', 'Read aloud', 'Spoken from the cue', 'Spoken from memory'];
  $speaking.subscribe((speaking) => {
    document.querySelectorAll<HTMLElement>('[data-talk]').forEach((label) => {
      label.textContent = REACHED[speaking.talks[label.dataset.talk ?? ''] ?? 0] ?? REACHED[0]!;
    });
  });
</script>
