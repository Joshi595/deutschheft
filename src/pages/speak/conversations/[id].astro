---
import ConversationRunner from '../../../components/speak/ConversationRunner';
import Base from '../../../layouts/Base.astro';
import { getCatalog } from '../../../lib/content/catalog';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.talks.map((talk) => ({ params: { id: talk.id } }));
}

const catalog = await getCatalog();
const talk = catalog.talks.find((candidate) => candidate.id === Astro.params.id)!;
---

<Base title={`${talk.titleDe} (${talk.title})`} description={talk.scene} width="narrow">

  <header class="mt-4">
    <p class="eyebrow">{talk.level.toUpperCase()} conversation</p>
    <h1 class="mt-1 text-4xl sm:text-5xl" lang="de">{talk.titleDe}</h1>
    <p class="mt-2 text-lg text-muted">{talk.title}</p>
  </header>

  <div class="mt-8">
    <ConversationRunner client:only="react" talk={talk} listHref={url('speak/conversations/')}>
      <div slot="fallback" class="card p-6 text-muted">Setting the scene …</div>
    </ConversationRunner>
  </div>
</Base>
