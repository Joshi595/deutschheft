---
import VoiceNotice from '../../../components/ui/VoiceNotice.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import ConversationRunner from '../../../components/speak/ConversationRunner';
import Base from '../../../layouts/Base.astro';
import { getCatalog } from '../../../lib/content/catalog';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.talks.map((talk) => ({ params: { id: talk.id } }));
}

const catalog = await getCatalog();
const talk = catalog.talks.find((candidate) => candidate.id === Astro.params.id)!;
---

<Base title={`${talk.titleDe} (${talk.title})`} description={talk.scene} width="narrow">
  <PageHeader
    title={talk.titleDe}
    lang="de"
    crumbs={[{ label: 'Speak', href: url('speak/') }, { label: 'Conversations', href: url('speak/conversations/') }, { label: `${talk.level.toUpperCase()} conversation` }]}
    lead={talk.title}
  />
  <VoiceNotice />

  <div class="mt-8">
    <ConversationRunner client:only="react" talk={talk} listHref={url('speak/conversations/')}>
      <div slot="fallback" class="skeleton min-h-48" role="status"><span class="sr-only">Setting the scene …</span></div>
    </ConversationRunner>
  </div>
</Base>