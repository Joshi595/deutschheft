---
import VoiceNotice from '../../components/ui/VoiceNotice.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import MissionRunner from '../../components/missions/MissionRunner';
import Base from '../../layouts/Base.astro';
import { getCatalog } from '../../lib/content/catalog';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.missions.map((mission) => ({ params: { mission: mission.id } }));
}

const catalog = await getCatalog();
const index = catalog.missions.findIndex((candidate) => candidate.id === Astro.params.mission);
const mission = catalog.missions[index]!;
const next = catalog.missions[index + 1];
---

<Base title={`${mission.titleDe} (${mission.title})`} description={mission.objective} width="narrow">
  <PageHeader
    title={mission.titleDe}
    lang="de"
    crumbs={[{ label: 'Speak', href: url('speak/') }, { label: 'Conversations', href: url('speak/conversations/') }, { label: `${mission.level.toUpperCase()} mission` }]}
    lead={mission.title}
  />
  <VoiceNotice />

  <div class="mt-8">
    <MissionRunner
      client:only="react"
      mission={mission}
      next={next && { href: next.href, title: next.titleDe }}
      listHref={url('speak/conversations/')}
      speakHref={url(`speak/conversations/${mission.id}/`)}
    >
      <div slot="fallback" class="skeleton min-h-48" role="status"><span class="sr-only">Setting the scene …</span></div>
    </MissionRunner>
  </div>
</Base>
