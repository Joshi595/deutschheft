---
import PageHeader from '../../../components/ui/PageHeader.astro';
import QuizRunner from '../../../components/quiz/QuizRunner';
import Base from '../../../layouts/Base.astro';
import { getCatalog } from '../../../lib/content/catalog';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.levels.flatMap((level) =>
    level.quizzes.map((quiz) => ({
      params: { level: level.id, exam: quiz.id.split('/')[1]! },
      props: { quizId: quiz.id },
    })),
  );
}

interface Props {
  quizId: string;
}

const catalog = await getCatalog();
const level = catalog.levels.find((candidate) => candidate.id === Astro.params.level)!;
const quiz = level.quizzes.find((candidate) => candidate.id === Astro.props.quizId)!;
---

<Base title={`${quiz.title} (${level.title})`} description={quiz.description} width="narrow">
  <PageHeader
    title={quiz.title}
    crumbs={[{ label: 'Learn', href: url('learn/') }, { label: level.title, href: level.href }, { label: 'Mock exam' }]}
    lead={level.exam}
  />

  <div class="mt-8">
    <QuizRunner client:only="react" quiz={quiz}>
      <div slot="fallback" class="skeleton min-h-48" role="status"><span class="sr-only">Loading the exam …</span></div>
    </QuizRunner>
  </div>
</Base>
