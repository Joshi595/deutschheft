---
import { render } from 'astro:content';
import ExerciseRunner from '../../components/exercises/ExerciseRunner';
import Example from '../../components/lesson/Example.astro';
import Compare from '../../components/lesson/Compare.astro';
import GrammarBox from '../../components/lesson/GrammarBox.astro';
import Mistake from '../../components/lesson/Mistake.astro';
import Step from '../../components/lesson/Step.astro';
import Summary from '../../components/lesson/Summary.astro';
import VocabList from '../../components/lesson/VocabList.astro';
import LessonNotes from '../../components/notebook/LessonNotes';
import ProgressMeter from '../../components/ui/ProgressMeter.astro';
import Base from '../../layouts/Base.astro';
import { getCatalog } from '../../lib/content/catalog';
import { url } from '../../lib/url';
import type { LocalSection } from '../../lib/navigation';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.lessons.map((lesson) => ({
    params: { level: lesson.level, lesson: lesson.slug },
    props: { lessonKey: lesson.key },
  }));
}

interface Props {
  lessonKey: string;
}

const catalog = await getCatalog();
const level = catalog.levels.find((candidate) => candidate.id === Astro.params.level)!;
const index = level.lessons.findIndex((candidate) => candidate.key === Astro.props.lessonKey);
const lesson = level.lessons[index]!;
const previous = level.lessons[index - 1];
const next = level.lessons[index + 1];

const { Content } = await render(lesson.entry);
const exerciseIds = lesson.exercises.map((exercise) => exercise.id);

const sections: LocalSection[] = [
  { id: 'lesson', label: 'Lesson', tone: 'lesson' },
  ...(lesson.vocab.length > 0 ? [{ id: 'vocabulary', label: 'Vocabulary', tone: 'vocabulary' as const }] : []),
  ...(lesson.sets.length > 0 ? [{ id: 'practice', label: 'Practice', tone: 'practice' as const }] : []),
  { id: 'notes', label: 'Notes', tone: 'notes' },
];
---

<Base title={`${lesson.title} (${level.title})`} description={lesson.summary} width="narrow" area="learn" localNav={sections} breadcrumbs={[
  { label: 'Learn', href: 'learn/' },
  { label: level.title, href: `${level.id}/` },
  { label: `Lesson ${lesson.order}: ${lesson.title}` },
]}>

  <header class="mt-4">
    {lesson.titleDe && <p class="eyebrow" lang="de">{lesson.titleDe}</p>}
    <h1 class="mt-1 text-4xl sm:text-5xl">{lesson.title}</h1>
    <p class="mt-4 text-lg text-muted">{lesson.summary}</p>
    <p class="mt-4 flex flex-wrap gap-2">
      <span class="chip">{lesson.minutes} min</span>
      {lesson.vocab.length > 0 && <span class="chip">{lesson.vocab.length} words</span>}
      {exerciseIds.length > 0 && <span class="chip">{exerciseIds.length} exercises</span>}
    </p>
    {exerciseIds.length > 0 && <div class="mt-5"><ProgressMeter ids={exerciseIds} /></div>}
  </header>


  <section id="lesson" data-tone="lesson" class="mt-8">
    <div class="section-heading"><h2>Lesson</h2><p>Understand the ideas, then put them into practice.</p></div>
    {
      lesson.objectives.length > 0 && (
        <div class="card mb-8 border-l-4 border-l-accent p-5">
          <p class="eyebrow">After this chapter you can</p>
          <ul class="mt-2 grid gap-1.5">
            {lesson.objectives.map((objective) => (
              <li class="flex gap-2">
                <span class="font-bold text-good" aria-hidden="true">✓</span>
                <span>{objective}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="prose lesson-reading">
      <Content components={{ GrammarBox, Example, Step, Compare, Mistake, Summary }} />
    </div>
  </section>

  {
    lesson.vocab.length > 0 && (
      <section id="vocabulary" data-tone="vocabulary" class="mt-14">
        <div class="section-heading">
        <h2 class="text-3xl">Vocabulary</h2>
        <p class="mt-2 mb-5 text-muted">
          Tap the speaker to hear a word. These join your review deck when you start the exercises.
        </p>
        </div>
        <VocabList items={lesson.vocab} />
      </section>
    )
  }

  {
    lesson.sets.length > 0 && (
      <section id="practice" data-tone="practice" class="mt-14">
        <div class="section-heading">
        <h2 class="text-3xl">Practice</h2>
        <p class="mt-2 mb-6 text-muted">
          You get a second try on typed answers. Anything you miss comes back in Review.
        </p>
        </div>
        <ExerciseRunner
          client:only="react"
          topic={lesson.title}
          sets={lesson.sets}
          vocabIds={lesson.vocabIds}
          next={next && { href: next.href, title: next.title }}
        >
          <p slot="fallback" class="text-muted">Loading exercises …</p>
        </ExerciseRunner>
      </section>
    )
  }

  <section id="notes" data-tone="notes" class="mt-14">
    <div class="section-heading"><h2>Notes</h2><p>Keep your own reminders from this lesson.</p></div>
    <div class="mt-4">
      <LessonNotes client:only="react" lessonKey={lesson.key} notebookHref={url('notebook/')} />
    </div>
  </section>

  <nav aria-label="Lessons" class="mt-14 grid gap-3 border-t border-line pt-6 sm:grid-cols-2">
    {
      previous ? (
        <a href={previous.href} class="card p-4 hover:border-ink">
          <span class="eyebrow">Previous</span>
          <span class="mt-1 block font-semibold">{previous.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a href={next.href} class="card p-4 text-right hover:border-ink">
          <span class="eyebrow">Next</span>
          <span class="mt-1 block font-semibold">{next.title}</span>
        </a>
      ) : (
        <a href={level.href} class="card p-4 text-right hover:border-ink">
          <span class="eyebrow">End of {level.title}</span>
          <span class="mt-1 block font-semibold">Back to all lessons</span>
        </a>
      )
    }
  </nav>
</Base>
