---
import ReadinessPanel from '../../components/dashboard/ReadinessPanel';
import Icon from '../../components/ui/Icon.astro';
import ProgressMeter from '../../components/ui/ProgressMeter.astro';
import Base from '../../layouts/Base.astro';
import { getCatalog, toLevelSummary } from '../../lib/content/catalog';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.levels.map((level) => ({ params: { level: level.id } }));
}

const catalog = await getCatalog();
const level = catalog.levels.find((candidate) => candidate.id === Astro.params.level)!;
const exerciseIds = level.lessons.flatMap((lesson) => lesson.exercises.map((exercise) => exercise.id));
const byKey = new Map(level.lessons.map((lesson) => [lesson.key, lesson]));
const units = level.units.filter((unit) => unit.lessonKeys.length > 0);
const ids = (key: string) => JSON.stringify(byKey.get(key)!.exercises.map((exercise) => exercise.id));
---

<Base title={`${level.title} ${level.name}`} description={level.description}>
  <nav aria-label="Breadcrumb" class="flex gap-x-1.5 text-sm text-muted">
    <a href={url('learn/')} class="hover:text-ink hover:underline">Learn</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{level.title}</span>
  </nav>

  <header class="mt-6 max-w-3xl">
    <h1>
      <span class="numeral block text-[7rem] text-accent sm:text-[9rem]">{level.title}</span>
      <span class="mt-2 block text-4xl sm:text-5xl">{level.name}</span>
    </h1>
    <p class="mt-4 text-lg text-muted">{level.description}</p>
    {exerciseIds.length > 0 && <div class="mt-6"><ProgressMeter ids={exerciseIds} /></div>}
  </header>

  {
    level.lessons.length === 0 ? (
      <p class="mt-10 border-l-4 border-line bg-surface-2 p-6 text-muted">No chapters here yet. This level is planned.</p>
    ) : (
      <>
        <details class="group mt-8 max-w-3xl border-y border-line" aria-label="Exam readiness">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 py-3 font-semibold [&::-webkit-details-marker]:hidden">
            How ready you are for the {level.exam ?? `${level.title} exam`}
            <Icon name="next" size={18} class="flex-none rotate-90 transition-transform group-open:-rotate-90" />
          </summary>
          <div class="pb-5">
            <ReadinessPanel client:only="react" level={toLevelSummary(level)} />
          </div>
        </details>

        {units.map((unit) => (
          <section class="mt-14" aria-labelledby={`unit-${unit.number}`}>
            <header class="flex items-start gap-4 border-t-2 border-ink pt-4">
              <span class="numeral w-12 flex-none text-6xl text-muted" aria-hidden="true">{unit.number}</span>
              <div>
                <h2 id={`unit-${unit.number}`} class="text-2xl sm:text-3xl">
                  <span class="sr-only">Unit {unit.number}: </span>
                  {unit.title ?? `Unit ${unit.number}`}
                </h2>
                {unit.summary && <p class="mt-1 text-muted">{unit.summary}</p>}
              </div>
            </header>
            <ol class="mt-5 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
              {unit.lessonKeys.map((key) => {
                const lesson = byKey.get(key)!;
                return (
                  <li class="flex border-r border-b border-line">
                    {/* data-state is set from progress: done, next (the first not done), started or open. */}
                    <a
                      href={lesson.href}
                      data-chapter={ids(key)}
                      class="group flex w-full flex-col gap-2 bg-bg p-4 transition-colors hover:bg-surface-2 data-[state=next]:bg-accent data-[state=next]:text-accent-ink data-[state=next]:[&_.text-muted]:text-accent-ink/80"
                    >
                      <span class="flex items-start justify-between gap-3">
                        <span class="numeral text-5xl text-muted group-data-[state=done]:!text-good">{String(lesson.order).padStart(2, '0')}</span>
                        <span class="hidden text-sm font-semibold group-data-[state=next]:inline">Up next</span>
                        <span class="hidden text-good group-data-[state=done]:inline" role="img" aria-label="Finished">
                          <Icon name="check" size={22} />
                        </span>
                      </span>
                      <span class="font-semibold leading-snug">{lesson.title}</span>
                      {lesson.titleDe && <span class="text-sm text-muted" lang="de">{lesson.titleDe}</span>}
                      <span class="mt-auto flex items-center gap-2 pt-2 text-sm text-muted">
                        {lesson.kind === 'exam' ? 'Exam training, ' : ''}
                        {lesson.minutes} min
                      </span>
                      <ProgressMeter ids={lesson.exercises.map((exercise) => exercise.id)} />
                    </a>
                  </li>
                );
              })}
              {unit.checkpointHref && (
                <li class="flex border-r border-b border-line">
                  <a href={unit.checkpointHref} class="flex w-full flex-col gap-2 bg-surface-2 p-4 transition-colors hover:bg-line">
                    <Icon name="check" size={28} class="text-muted" />
                    <span class="font-semibold">Checkpoint</span>
                    <span class="text-sm text-muted">A short mixed quiz over this unit, with no hints.</span>
                    <span class="mt-auto pt-2 text-sm font-semibold underline underline-offset-4">Take the checkpoint</span>
                  </a>
                </li>
              )}
            </ol>
          </section>
        ))}

        {level.exams.length > 0 && (
          <section class="mt-14" aria-labelledby="mock-exams">
            <header class="border-t-2 border-ink pt-4">
              <h2 id="mock-exams" class="text-2xl sm:text-3xl">Mock exams</h2>
              <p class="mt-1 text-muted">
                Full practice papers in the format of the {level.exam ?? `${level.title} exam`}, about {level.exams[0]!.minutes} minutes each.
              </p>
            </header>
            <ol class="mt-5 grid grid-cols-2 border-t border-l border-line sm:grid-cols-5">
              {level.exams.map((exam, index) => (
                <li class="flex border-r border-b border-line">
                  <a href={exam.href} data-exam={exam.id} class="group flex w-full flex-col gap-1 bg-bg p-4 transition-colors hover:bg-surface-2" title={exam.description}>
                    <span class="numeral text-5xl">{String(index + 1).padStart(2, '0')}</span>
                    <span class="text-sm text-muted">{exam.title}</span>
                    <span data-exam-score class="text-sm font-semibold">Not taken</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}
      </>
    )
  }
</Base>

<script>
  import { completion } from '../../lib/progress/logic';
  import { $progress, $quizzes } from '../../lib/stores';

  // Each chapter tile shows whether it is done, and the first one that is not is marked as next.
  $progress.subscribe((state) => {
    let next = false;
    document.querySelectorAll<HTMLElement>('[data-chapter]').forEach((tile) => {
      const { complete, done } = completion(state, JSON.parse(tile.dataset.chapter ?? '[]') as string[]);
      tile.dataset.state = complete ? 'done' : !next ? ((next = true), 'next') : done > 0 ? 'started' : 'open';
    });
  });

  // Each mock exam shows its best score so far.
  $quizzes.subscribe((history) => {
    document.querySelectorAll<HTMLElement>('[data-exam]').forEach((tile) => {
      const attempts = history[tile.dataset.exam ?? ''] ?? [];
      const label = tile.querySelector<HTMLElement>('[data-exam-score]');
      if (!label || attempts.length === 0) return;
      const percent = (attempt: (typeof attempts)[number]) =>
        Math.round((100 * attempt.total) / Math.max(1, attempt.sections.reduce((sum, section) => sum + section.max, 0)));
      const best = attempts.reduce((top, attempt) => (percent(attempt) > percent(top) ? attempt : top));
      label.textContent = `Best ${percent(best)}%${best.passed ? ', passed' : ''}`;
      label.classList.toggle('text-good', best.passed);
    });
  });
</script>
