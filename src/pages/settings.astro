---
import SettingsPage from '../components/settings/SettingsPage';
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/content/catalog';

const catalog = await getCatalog();
const levels = catalog.levels
  .filter((level) => level.status === 'active' && level.lessons.length > 0)
  .map(({ id, title, name }) => ({ id, title, name }));
---

<Base area="settings" localNav={[
  { id: 'learning', label: 'Learning' }, { id: 'appearance', label: 'Appearance' },
  { id: 'audio', label: 'Audio' }, { id: 'speaking', label: 'Speaking' },
  { id: 'ai', label: 'AI explanations' }, { id: 'data', label: 'Your data' },
]} title="Settings" description="Level and daily goal, appearance, audio, optional AI key and data backup." width="narrow">
  <header>
    <p class="eyebrow" lang="de">Einstellungen</p>
    <h1 class="mt-1 text-4xl sm:text-5xl">Settings</h1>
  </header>

  <div class="mt-8">
    <SettingsPage client:only="react" levels={levels}>
      <div slot="fallback" class="card p-6 text-muted">Loading settings …</div>
    </SettingsPage>
  </div>
</Base>
