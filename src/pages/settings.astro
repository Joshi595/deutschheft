---
import PageHeader from '../components/ui/PageHeader.astro';
import SettingsPage from '../components/settings/SettingsPage';
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/content/catalog';

const catalog = await getCatalog();
const levels = catalog.levels
  .filter((level) => level.status === 'active' && level.lessons.length > 0)
  .map(({ id, title, name }) => ({ id, title, name }));
---

<Base title="Settings" description="Level and daily goal, theme, audio, optional AI key and data backup." width="narrow">
  <PageHeader title="Settings" />

  <div class="mt-8">
    <SettingsPage client:only="react" levels={levels}>
      <div slot="fallback" class="skeleton min-h-48" role="status"><span class="sr-only">Loading settings …</span></div>
    </SettingsPage>
  </div>
</Base>
