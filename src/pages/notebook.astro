---
import PageHeader from '../components/ui/PageHeader.astro';
import NotebookPage from '../components/notebook/NotebookPage';
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/content/catalog';

const catalog = await getCatalog();
const lessons = Object.fromEntries([
  ...catalog.lessons.map((lesson) => [lesson.key, { title: lesson.title, href: lesson.href, level: lesson.level }]),
  // Mistakes made in a mission are logged under the mission's own key.
  ...catalog.missions.map((mission) => [`mission.${mission.id}`, { title: mission.titleDe, href: mission.href, level: mission.level }]),
]);
---

<Base title="Notebook" description="Your saved words, lesson notes and mistakes log." width="narrow">
  <PageHeader title="Notebook" lead="Your own words, the notes you wrote in lessons, and the answers you got wrong." />

  <div class="mt-8">
    <NotebookPage client:only="react" lessons={lessons}>
      <div slot="fallback" class="skeleton min-h-48" role="status"><span class="sr-only">Opening your notebook …</span></div>
    </NotebookPage>
  </div>
</Base>
