---
import type { ClientVocabItem } from '../../lib/content/types';
import SpeakButton from '../ui/SpeakButton.astro';

interface Props {
  items: ClientVocabItem[];
}
const { items } = Astro.props;

const headword = (item: ClientVocabItem) => (item.article ? `${item.article} ${item.de}` : item.de);
// A noun's gender as a bar down the left edge; the classes are written out so Tailwind finds them.
const bar = { der: 'border-l-der', die: 'border-l-die', das: 'border-l-das' } as const;
---

<div class="vocab">
  <label class="mb-2 inline-flex cursor-pointer items-center gap-2 text-sm text-muted">
    <input type="checkbox" class="hide-en size-4 accent-[var(--accent)]" />
    Hide English to test yourself
  </label>
  <ul class="divide-y divide-line border-y-2 border-ink">
    {
      items.map((item) => (
        <li class:list={['flex items-start gap-2 border-l-4 py-3 pr-1 pl-3 sm:pl-4', item.article ? bar[item.article] : 'border-l-transparent']}>
          <SpeakButton text={headword(item)} />
          <div class="min-w-0 flex-1">
            <p class="flex flex-wrap items-baseline gap-x-2">
              <span class="de text-lg" lang="de">
                {item.article && <span class={`gender-${item.article}`}>{item.article}</span>} {item.de}
              </span>
              {item.plural && item.plural !== '-' && (
                <span class="text-sm text-muted" lang="de">pl. die {item.plural}</span>
              )}
              <span class="vocab-en text-muted">{item.en}</span>
            </p>
            {item.example && (
              <p class="mt-0.5 text-sm">
                <span lang="de">{item.example}</span>
                {item.exampleEn && <span class="vocab-en text-muted"> {item.exampleEn}</span>}
              </p>
            )}
          </div>
          {item.example && <SpeakButton text={item.example} />}
        </li>
      ))
    }
  </ul>
</div>
