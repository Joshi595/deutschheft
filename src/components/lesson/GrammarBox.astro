---
// Available in every lesson's MDX without an import.
interface Props {
  title: string;
  /** Small label above the title. */
  label?: string;
}
const { title, label = 'Grammar' } = Astro.props;
---

<aside class="border-l-4 border-accent bg-surface-2 p-5">
  <p class="eyebrow">{label}</p>
  <p class="font-display mt-1 text-xl">{title}</p>
  <div class="mt-3 grid gap-3"><slot /></div>
</aside>
