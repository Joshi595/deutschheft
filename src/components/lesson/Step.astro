---
// One step of the "Step by step" section. Available in every lesson's MDX.
// <Step n="1" title="The verb comes second"> … </Step>
interface Props {
  n: string | number;
  title: string;
}
const { n, title } = Astro.props;
---

<section>
  <p class="flex items-baseline gap-3 border-t border-line pt-4">
    <span class="numeral w-8 flex-none text-4xl text-accent">{n}</span>
    <span class="font-display text-xl">{title}</span>
  </p>
  <div class="mt-3 grid gap-3 sm:pl-11"><slot /></div>
</section>
