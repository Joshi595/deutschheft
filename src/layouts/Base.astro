---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import TranslatePanel from '../components/translate/TranslatePanel';
import Icon from '../components/ui/Icon.astro';
import type { IconName } from '../components/ui/icons';
import { site } from '../site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Narrow reading column (lessons) or wide (dashboards and lists). */
  width?: 'narrow' | 'wide';
}

const { title, description = site.description, width = 'wide' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const path = Astro.url.pathname;

const nav: { href: string; label: string; icon: IconName }[] = [
  { href: url(''), label: 'Today', icon: 'today' },
  { href: url('learn/'), label: 'Learn', icon: 'learn' },
  { href: url('speak/'), label: 'Speak', icon: 'speak' },
  { href: url('review/'), label: 'Review', icon: 'review' },
  { href: url('notebook/'), label: 'Notebook', icon: 'notebook' },
];
const [today, learn, speak] = nav as [(typeof nav)[number], (typeof nav)[number], (typeof nav)[number], ...typeof nav];
const elsewhere = [url('settings/'), url('progress/')];
// Levels and lessons live under "Learn", so it is the fallback; settings and progress light up nothing.
const active =
  path === today.href
    ? today
    : elsewhere.some((href) => path.startsWith(href))
      ? undefined
      : path.startsWith(url('missions/'))
        ? speak
        : (nav.slice(1).find((item) => path.startsWith(item.href)) ?? learn);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101318" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Apply a saved theme before first paint to avoid a flash.
      try {
        var saved = JSON.parse(localStorage.getItem('lg:settings:v1') || '{}');
        if (saved.theme === 'light' || saved.theme === 'dark') {
          document.documentElement.dataset.theme = saved.theme;
        }
      } catch (error) {}
    </script>
  </head>
  <body class="flex flex-col pb-[calc(var(--tabbar-h)+env(safe-area-inset-bottom))] sm:pb-0 sm:pl-(--sidebar-w)">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 btn">Skip to content</a>

    <header class="shell">
      <a href={url('')} class="flex items-center gap-2.5 sm:max-lg:justify-center sm:px-0.5 lg:px-1.5" aria-label={`${site.name}, today`}>
        <span class="mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="font-display text-lg leading-none sm:max-lg:sr-only">{site.name}</span>
      </a>

      <nav aria-label="Main" class="hidden flex-col gap-1 sm:flex">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={item === active ? 'page' : undefined} class="shell-link" title={item.label}>
              <Icon name={item.icon} size={22} />
              <span class="max-lg:sr-only">{item.label}</span>
              {item.label === 'Review' && <span data-due-badge hidden class="badge absolute top-0.5 right-0.5 lg:static lg:ml-auto" />}
            </a>
          ))
        }
      </nav>

      <div class="shell-tools">
        <a
          href={url('progress/')}
          data-goal-chip
          aria-current={path.startsWith(url('progress/')) ? 'page' : undefined}
          class="shell-link tabular-nums"
          title="Today's points. Open your progress."
        >
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" class="flex-none">
            <circle cx="11" cy="11" r="8.5" fill="none" stroke="var(--line)" stroke-width="3.5"></circle>
            <circle data-goal-arc cx="11" cy="11" r="8.5" fill="none" stroke="var(--signal)" stroke-width="3.5" stroke-dasharray="53.4" stroke-dashoffset="53.4" transform="rotate(-90 11 11)" style="transition: stroke-dashoffset 0.5s ease"></circle>
          </svg>
          <span class="text-ink sm:max-lg:sr-only"><span data-goal-text>Progress</span><span class="max-lg:hidden font-normal text-muted"> today</span></span>
        </a>
        <button type="button" class="shell-link" data-translate-open aria-controls="translate-panel" aria-expanded="false" title="Translate. Select text first to translate it.">
          <Icon name="translate" size={22} />
          <span class="max-lg:sr-only">Translate</span>
        </button>
        <a
          href={url('settings/')}
          aria-current={path.startsWith(url('settings/')) ? 'page' : undefined}
          class="shell-link"
          title="Settings"
        >
          <Icon name="settings" size={22} />
          <span class="max-lg:sr-only">Settings</span>
        </a>
      </div>
    </header>

    <main id="main" class:list={['w-full flex-1 px-4 pt-8 pb-16 sm:px-10 sm:pt-12 lg:px-16', width === 'narrow' ? 'max-w-[54rem]' : 'max-w-[80rem]']}>
      <slot />
    </main>

    <footer class="border-t border-line px-4 py-6 text-sm text-muted sm:px-10 lg:px-16">
      <div class="flex max-w-[64rem] flex-wrap items-center justify-between gap-3">
        <p>{site.name}. Your progress is stored in this browser only.</p>
        <a href={site.repo} class="underline underline-offset-4 hover:text-ink">Source on GitHub</a>
      </div>
    </footer>

    <nav aria-label="Main" class="tabbar sm:hidden">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={item === active ? 'page' : undefined}>
            <span class="tab-icon">
              <Icon name={item.icon} size={22} />
              {item.label === 'Review' && <span data-due-badge hidden class="badge absolute -top-1 left-7 ring-2 ring-bg" />}
            </span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <TranslatePanel client:load wordsHref={url('words.json')} />

    <script>
      import { localDay, xpOn } from '../lib/progress/logic';
      import { germanAvailable, setPreferredVoice, speak } from '../lib/speech';
      import { dueCards } from '../lib/srs/scheduler';
      import { $progress, $review, $settings } from '../lib/stores';

      // Theme and chosen voice follow the settings live, including changes made in another tab.
      $settings.subscribe((settings) => {
        if (settings.theme === 'system') delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = settings.theme;
        setPreferredVoice(settings.voice);
      });

      // One click handler for every [data-speak] button on the page.
      document.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>('[data-speak]');
        if (button?.dataset.speak) speak(button.dataset.speak, $settings.get().speechRate);
      });

      // Hide the listen buttons only when we know there is no German voice.
      function checkVoices() {
        document.documentElement.classList.toggle('no-german-voice', germanAvailable() === false);
      }
      checkVoices();
      window.speechSynthesis?.addEventListener('voiceschanged', checkVoices);

      // The no-German-voice notice says its piece once; closing it hides it on every page.
      const NOTICE_KEY = 'lg:voice-notice-dismissed';
      function readDismissed() {
        try {
          return localStorage.getItem(NOTICE_KEY) === '1';
        } catch {
          return false;
        }
      }
      if (readDismissed()) document.querySelectorAll('[data-voice-notice]').forEach((notice) => notice.setAttribute('data-dismissed', ''));
      document.addEventListener('click', (event) => {
        const notice = (event.target as HTMLElement).closest('[data-voice-dismiss]')?.closest('[data-voice-notice]');
        if (!notice) return;
        document.querySelectorAll('[data-voice-notice]').forEach((each) => each.setAttribute('data-dismissed', ''));
        try {
          localStorage.setItem(NOTICE_KEY, '1');
        } catch {}
      });

      // Due-card count next to "Review", in the sidebar and in the tab bar.
      $review.subscribe((review) => {
        const due = dueCards(review, new Date()).length;
        document.querySelectorAll<HTMLElement>('[data-due-badge]').forEach((badge) => {
          badge.hidden = due === 0;
          badge.textContent = due > 99 ? '99+' : String(due);
          badge.setAttribute('aria-label', `${due} cards due`);
        });
      });

      // Today's points against the daily goal, in the shell.
      function paintGoal() {
        const chip = document.querySelector<HTMLElement>('[data-goal-chip]');
        const arc = chip?.querySelector<SVGCircleElement>('[data-goal-arc]');
        const text = chip?.querySelector<HTMLElement>('[data-goal-text]');
        if (!chip || !arc || !text) return;
        const earned = xpOn($progress.get(), localDay(new Date()));
        const goal = $settings.get().dailyGoal;
        const share = goal > 0 ? Math.min(1, earned / goal) : 0;
        arc.style.strokeDashoffset = String(53.4 * (1 - share));
        arc.style.stroke = share >= 1 ? 'var(--good)' : 'var(--signal)';
        text.textContent = goal > 0 ? `${earned}/${goal}` : `${earned}`;
        chip.setAttribute(
          'aria-label',
          goal > 0 ? `${earned} of ${goal} points today. Open your progress.` : `${earned} points today. Open your progress.`,
        );
      }
      $progress.subscribe(paintGoal);
      $settings.subscribe(paintGoal);

      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/sw.js`).catch(() => {});
      }
    </script>
  </body>
</html>
