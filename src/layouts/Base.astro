---
import '@fontsource-variable/inter';
import '../styles/global.css';
import TranslatePanel from '../components/translate/TranslatePanel';
import LocalNav from '../components/ui/LocalNav.astro';
import { AREAS, resolveLocation, type Area, type Breadcrumb, type LocalSection } from '../lib/navigation';
import { site } from '../site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  width?: 'narrow' | 'wide';
  area?: Area;
  breadcrumbs?: Breadcrumb[];
  localNav?: LocalSection[];
}

const { title, description = site.description, width = 'wide', area: explicitArea, breadcrumbs: explicitCrumbs, localNav = [] } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const location = resolveLocation(Astro.url.pathname, import.meta.env.BASE_URL, title);
const area = explicitArea ?? location.area;
const active = AREAS.find((item) => item.id === area);
const breadcrumbs = explicitCrumbs ?? location.breadcrumbs;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F8FAFD" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Migrate only the appearance preference; learning data and other settings stay intact.
      try {
        var saved = JSON.parse(localStorage.getItem('lg:settings:v1') || 'null');
        if (saved && typeof saved === 'object' && saved.theme !== 'light') {
          saved.theme = 'light';
          localStorage.setItem('lg:settings:v1', JSON.stringify(saved));
        }
      } catch (error) {}
    </script>
  </head>
  <body data-area={area} class:list={['app-body', localNav.length > 0 && 'has-local-nav']}>
    <a href="#main" class="skip-link btn">Skip to content</a>

    <aside class="sidebar" aria-label="App navigation">
      <a href={url('')} class="brand"><span class="brand-mark" aria-hidden="true">D</span>{site.name}<span class="brand-dot">.</span></a>
      <p class="sidebar-label">YOUR LEARNING SPACE</p>
      <nav aria-label="Main">
        {AREAS.map((item, index) => (
          <a href={url(item.path)} data-area={item.id} aria-current={item.id === area ? 'page' : undefined} class:list={['sidebar-link', index === 5 && 'sidebar-secondary']}>
            <span class="nav-icon"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg></span>
            <span>{item.label}</span>
            {item.id === 'review' && <span data-due-badge hidden class="chip ml-auto" />}
            {item.id === area && <span class="active-dot" aria-hidden="true" />}
          </a>
        ))}
      </nav>
      <div class="sidebar-note"><span aria-hidden="true">✦</span><p>A little German.<br /><strong>A little every day.</strong></p></div>
    </aside>

    <div class="app-content">
      <header class="location-header" data-location-header>
        <div class="location-inner">
          <div class="location-copy">
            <a href={url('')} class="mobile-brand">{site.name}<span class="brand-dot">.</span></a>
            <span class="area-badge">{active?.label ?? 'Deutschheft'}</span>
            <nav aria-label="Breadcrumb" class="breadcrumbs">
              <ol>{breadcrumbs.map((crumb, index) => (
                <li>
                  {index > 0 && <span aria-hidden="true" class="crumb-separator">/</span>}
                  {crumb.href !== undefined && index < breadcrumbs.length - 1
                    ? <a href={url(crumb.href)}>{crumb.label}</a>
                    : <span aria-current="page">{crumb.label}</span>}
                </li>
              ))}</ol>
            </nav>
          </div>
          <div class="header-actions">
            <a href={url('progress/')} data-goal-chip aria-label="Open your progress" title="Progress" data-area="progress" class="goal-chip">
              <svg width="24" height="24" viewBox="0 0 22 22" aria-hidden="true">
                <circle cx="11" cy="11" r="8.5" fill="none" stroke="var(--area-line)" stroke-width="3" />
                <circle data-goal-arc cx="11" cy="11" r="8.5" fill="none" stroke="var(--area-ink)" stroke-width="3" stroke-linecap="round" stroke-dasharray="53.4" stroke-dashoffset="53.4" transform="rotate(-90 11 11)" />
              </svg>
              <span data-goal-text>Progress</span>
            </a>
            <a href={url('settings/')} data-area="settings" aria-label="Settings" aria-current={area === 'settings' ? 'page' : undefined} title="Settings" class="settings-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d={AREAS[6].icon} /></svg>
            </a>
          </div>
        </div>
      </header>
      {localNav.length > 0 && <LocalNav sections={localNav} />}

      <main id="main" class:list={['main-content', width === 'narrow' && 'main-narrow']}>
        <p data-voice-notice class="voice-notice card mb-6 px-4 py-3 text-sm">
          This browser has no German voice, so listening is switched off wherever there is no recording.{' '}
          <a href={`${url('settings/')}#audio`} class="font-semibold underline underline-offset-4">How to get it back</a>
        </p>
        <slot />
      </main>
      <footer class="app-footer"><p>{site.name}. Your progress is stored in this browser only.</p><a href={site.repo}>Source on GitHub ↗</a></footer>
    </div>

    <nav aria-label="Main" class="tabbar">
      {AREAS.slice(0, 5).map((item) => (
        <a href={url(item.path)} data-area={item.id} aria-current={item.id === area ? 'page' : undefined}>
          <span class="tab-icon relative">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
            {item.id === 'review' && <span data-due-badge hidden class="chip absolute -top-1 left-7 px-1.5 text-[0.65rem]" />}
          </span>
          {item.label}
        </a>
      ))}
    </nav>
    <TranslatePanel client:load wordsHref={url('words.json')} />

    <script>
      import { localDay, xpOn } from '../lib/progress/logic';
      import { germanAvailable, setPreferredVoice, speak } from '../lib/speech';
      import { dueCards } from '../lib/srs/scheduler';
      import { $progress, $review, $settings } from '../lib/stores';
      import { installSectionNavigation } from '../lib/section-navigation';

      // The chosen voice follows settings live; appearance always stays light.
      $settings.subscribe((settings) => {
        document.documentElement.dataset.theme = 'light';
        setPreferredVoice(settings.voice);
      });

      // One click handler for every [data-speak] button on the page.
      document.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>('[data-speak]');
        if (button?.dataset.speak) speak(button.dataset.speak, $settings.get().speechRate);
      });

      // Hide the listen buttons only when we know there is no German voice.
      function checkVoices() {
        document.documentElement.classList.toggle('no-german-voice', germanAvailable() === false);
      }
      checkVoices();
      window.speechSynthesis?.addEventListener('voiceschanged', checkVoices);

      // Due-card count next to "Review", in the top bar and in the tab bar.
      $review.subscribe((review) => {
        const due = dueCards(review, new Date()).length;
        document.querySelectorAll<HTMLElement>('[data-due-badge]').forEach((badge) => {
          badge.hidden = due === 0;
          badge.textContent = due > 99 ? '99+' : String(due);
          badge.setAttribute('aria-label', `${due} cards due`);
        });
      });

      // Today's points against the daily goal, in the top bar.
      function paintGoal() {
        const chip = document.querySelector<HTMLElement>('[data-goal-chip]');
        const arc = chip?.querySelector<SVGCircleElement>('[data-goal-arc]');
        const text = chip?.querySelector<HTMLElement>('[data-goal-text]');
        if (!chip || !arc || !text) return;
        const earned = xpOn($progress.get(), localDay(new Date()));
        const goal = $settings.get().dailyGoal;
        const share = goal > 0 ? Math.min(1, earned / goal) : 0;
        arc.style.strokeDashoffset = String(53.4 * (1 - share));
        arc.style.stroke = share >= 1 ? 'var(--good)' : 'var(--area-ink)';
        text.textContent = goal > 0 ? `${earned}/${goal}` : `${earned}`;
        chip.setAttribute(
          'aria-label',
          goal > 0 ? `${earned} of ${goal} points today. Open your progress.` : `${earned} points today. Open your progress.`,
        );
      }
      $progress.subscribe(paintGoal);
      $settings.subscribe(paintGoal);

      const header = document.querySelector<HTMLElement>('[data-location-header]');
      const localNav = document.querySelector<HTMLElement>('[data-local-nav]');
      const measure = new ResizeObserver(() => {
        document.documentElement.style.setProperty('--header-height', `${header?.getBoundingClientRect().height ?? 80}px`);
        document.documentElement.style.setProperty('--local-nav-height', `${localNav?.getBoundingClientRect().height ?? 0}px`);
      });
      if (header) measure.observe(header);
      if (localNav) measure.observe(localNav);
      installSectionNavigation();

      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/sw.js`).catch(() => {});
      }
    </script>
  </body>
</html>
